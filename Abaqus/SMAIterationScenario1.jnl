from connectorBehavior import *
mdb.Model(name='Model_01')
mdb.models['Model_01'].setValues(absoluteZero=0.0, stefanBoltzmann=5.67e-08)
mdb.openStep('H:/STAR-Simulator/FreeCAD/SMAStrip (Nitinol).stp', scaleFromFile=
    OFF)
mdb.models['Model_01'].PartFromGeometryFile(combine=False, dimensionality=
    THREE_D, geometryFile=mdb.acis, name='SMAStrip (Nitinol)', type=
    DEFORMABLE_BODY)
mdb.models['Model_01'].Material(name='Aluminum')
mdb.models['Model_01'].materials['Aluminum'].Elastic(table=((70000000000.0, 
    0.3), ))
mdb.models['Model_01'].materials['Aluminum'].Conductivity(table=((100.0, ), ))
mdb.models['Model_01'].materials['Aluminum'].SpecificHeat(table=((900.0, ), ))
mdb.models['Model_01'].materials['Aluminum'].Density(table=((2300.0, ), ))
mdb.models['Model_01'].materials['Aluminum'].Expansion(table=((0.0, ), ))
mdb.models['Model_01'].Material(name='FakeSMA')
mdb.models['Model_01'].materials['FakeSMA'].Elastic(table=((90000000000.0, 
    0.3), ))
mdb.models['Model_01'].materials['FakeSMA'].Conductivity(table=((50.0, ), ))
mdb.models['Model_01'].materials['FakeSMA'].SpecificHeat(table=((800.0, ), ))
mdb.models['Model_01'].materials['FakeSMA'].Density(table=((6450.0, ), ))
mdb.models['Model_01'].materials['FakeSMA'].Expansion(table=((0.0025, ), ))
mdb.models['Model_01'].CompositeShellSection(idealization=NO_IDEALIZATION, 
    integrationRule=SIMPSON, layup=(SectionLayer(thickness=0.0025, 
    material='Aluminum', plyName='a'), SectionLayer(thickness=0.0025, 
    material='FakeSMA', plyName='b')), name='CompositeSection-1', 
    poissonDefinition=DEFAULT, preIntegrate=OFF, symmetric=False, temperature=
    GRADIENT, thicknessModulus=None, thicknessType=UNIFORM, useDensity=OFF)
mdb.models['Model_01'].parts['SMAStrip (Nitinol)'].Set(faces=
    mdb.models['Model_01'].parts['SMAStrip (Nitinol)'].faces, name='Set-1')
mdb.models['Model_01'].parts['SMAStrip (Nitinol)'].SectionAssignment(offset=0.0
    , offsetField='', offsetType=MIDDLE_SURFACE, region=
    mdb.models['Model_01'].parts['SMAStrip (Nitinol)'].sets['Set-1'], 
    sectionName='CompositeSection-1', thicknessAssignment=FROM_SECTION)
mdb.models['Model_01'].rootAssembly.DatumCsysByDefault(CARTESIAN)
mdb.models['Model_01'].rootAssembly.Instance(dependent=ON, name=
    'SMAStrip (Nitinol)', part=
    mdb.models['Model_01'].parts['SMAStrip (Nitinol)'])
mdb.models['Model_01'].CoupledTempDisplacementStep(amplitude=STEP, deltmx=2.0, 
    initialInc=0.5, maxInc=5.0, maxNumInc=200, minInc=4e-05, name='Bake_01', 
    previous='Initial', timePeriod=10.0)
mdb.models['Model_01'].steps['Bake_01'].Restart(frequency=1, numberIntervals=0, 
    overlay=ON)
mdb.models['Model_01'].rootAssembly.regenerate()
mdb.models['Model_01'].rootAssembly.Set(faces=
    mdb.models['Model_01'].rootAssembly.instances['SMAStrip (Nitinol)'].faces.findAt(
    ((0.333333, 0.033333, 0.0), (0.0, 0.0, 1.0)), ), name='Set-Temp')
mdb.models['Model_01'].Temperature(createStepName='Initial', 
    crossSectionDistribution=CONSTANT_THROUGH_THICKNESS, distributionType=
    UNIFORM, magnitudes=(4.0, ), name='Temp0', region=
    mdb.models['Model_01'].rootAssembly.sets['Set-Temp'])
mdb.models['Model_01'].rootAssembly.Set(edges=
    mdb.models['Model_01'].rootAssembly.instances['SMAStrip (Nitinol)'].edges.findAt(
    ((0.0, 0.0, 0.0), )), name='Fixed-Set')
mdb.models['Model_01'].EncastreBC(createStepName='Bake_01', localCsys=None, 
    name='FixEdge', region=
    mdb.models['Model_01'].rootAssembly.sets['Fixed-Set'])
mdb.models['Model_01'].TabularAmplitude(data=((0.0, 1.0), (4.0, 1.0)), name=
    'InstantVacuum', smooth=SOLVER_DEFAULT, timeSpan=STEP)
mdb.models['Model_01'].rootAssembly.Surface(name='All-Surfaces', side1Faces=
    mdb.models['Model_01'].rootAssembly.instances['SMAStrip (Nitinol)'].faces)
mdb.models['Model_01'].RadiationToAmbient(ambientTemperature=4.0, 
    ambientTemperatureAmp='InstantVacuum', createStepName='Bake_01', 
    distributionType=UNIFORM, emissivity=1.0, field='', name='ToVacuum', 
    radiationType=AMBIENT, surface=
    mdb.models['Model_01'].rootAssembly.surfaces['All-Surfaces'])
mdb.models['Model_01'].parts['SMAStrip (Nitinol)'].setElementType(elemTypes=(
    ElemType(elemCode=S4RT, elemLibrary=STANDARD, secondOrderAccuracy=OFF, 
    hourglassControl=DEFAULT), ElemType(elemCode=S3T, elemLibrary=STANDARD)), 
