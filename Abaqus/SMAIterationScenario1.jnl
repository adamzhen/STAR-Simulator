    faces=mdb.models['Model_01'].parts['SMAStrip (Nitinol)'].faces.findAt(((
    0.333333, 0.033333, 0.0), (0.0, 0.0, 1.0)), )))
mdb.models['Model_01'].parts['SMAStrip (Nitinol)'].seedPart(deviationFactor=0.1
