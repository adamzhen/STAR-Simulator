mdb.models['Model-1'].ConstrainedSketch(name='__profile__', sheetSize=2.0)
mdb.models['Model-1'].sketches['__profile__'].rectangle(point1=(0.0, 0.0), 
    point2=(1.0, 0.1))
mdb.models['Model-1'].Part(dimensionality=THREE_D, name='SMAStrip', type=
    DEFORMABLE_BODY)
mdb.models['Model-1'].parts['SMAStrip'].BaseShell(sketch=
    mdb.models['Model-1'].sketches['__profile__'])
del mdb.models['Model-1'].sketches['__profile__']
mdb.models['Model-1'].Material(name='Alum')
mdb.models['Model-1'].materials['Alum'].Density(table=((2300.0, ), ))
mdb.models['Model-1'].materials['Alum'].Elastic(table=((70000000000.0, 0.3), ))
mdb.models['Model-1'].materials['Alum'].Expansion(table=((0.0, ), ))
mdb.models['Model-1'].materials['Alum'].Conductivity(table=((100.0, ), ))
mdb.models['Model-1'].materials['Alum'].SpecificHeat(table=((897.0, ), ))
mdb.models['Model-1'].Material(name='FakeSMA')
mdb.models['Model-1'].materials['FakeSMA'].Density(table=((6450.0, ), ))
mdb.models['Model-1'].materials['FakeSMA'].Elastic(table=((70000000000.0, 0.3), 
    ))
mdb.models['Model-1'].materials['FakeSMA'].Expansion(table=((0.0025, ), ))
mdb.models['Model-1'].materials['FakeSMA'].Conductivity(table=((50.0, ), ))
mdb.models['Model-1'].materials['FakeSMA'].SpecificHeat(table=((800.0, ), ))
mdb.models['Model-1'].CompositeShellSection(idealization=NO_IDEALIZATION, 
    integrationRule=SIMPSON, layup=(SectionLayer(thickness=0.0025, 
    material='Alum', plyName='a'), SectionLayer(thickness=0.0025, 
    material='FakeSMA', plyName='b')), name='Section-1', poissonDefinition=
    DEFAULT, preIntegrate=OFF, symmetric=False, temperature=GRADIENT, 
    thicknessModulus=None, thicknessType=UNIFORM, useDensity=OFF)
mdb.models['Model-1'].parts['SMAStrip'].SectionAssignment(offset=0.0, 
    offsetField='', offsetType=MIDDLE_SURFACE, region=Region(
    faces=mdb.models['Model-1'].parts['SMAStrip'].faces.findAt(((0.333333, 
    0.033333, 0.0), (0.0, 0.0, 1.0)), )), sectionName='Section-1', 
    thicknessAssignment=FROM_SECTION)
mdb.models['Model-1'].rootAssembly.DatumCsysByDefault(CARTESIAN)
mdb.models['Model-1'].rootAssembly.Instance(dependent=ON, name='SMAStrip-1', 
    part=mdb.models['Model-1'].parts['SMAStrip'])
mdb.models['Model-1'].CoupledTempDisplacementStep(deltmx=5.0, initialInc=0.5, 
    maxInc=0.5, minInc=0.0001, name='Heat', nlgeom=ON, previous='Initial', 
    timePeriod=10.0)
mdb.models['Model-1'].EncastreBC(createStepName='Initial', localCsys=None, 
    name='FixRoot', region=Region(
    edges=mdb.models['Model-1'].rootAssembly.instances['SMAStrip-1'].edges.findAt(
    ((0.0, 0.025, 0.0), ), )))
mdb.models['Model-1'].SurfaceHeatFlux(createStepName='Heat', magnitude=1360.0, 
    name='Load-1', region=Region(
    side1Faces=mdb.models['Model-1'].rootAssembly.instances['SMAStrip-1'].faces.findAt(
    ((0.333333, 0.033333, 0.0), (0.0, 0.0, 1.0)), )))
mdb.models['Model-1'].parts['SMAStrip'].seedPart(deviationFactor=0.1, 
    minSizeFactor=0.1, size=0.05)
mdb.models['Model-1'].parts['SMAStrip'].generateMesh()
mdb.models['Model-1'].parts['SMAStrip'].deleteMesh()
mdb.models['Model-1'].parts['SMAStrip'].seedPart(deviationFactor=0.1, 
    minSizeFactor=0.1, size=0.005)
mdb.models['Model-1'].parts['SMAStrip'].generateMesh()
mdb.models['Model-1'].parts['SMAStrip'].deleteMesh()
mdb.models['Model-1'].parts['SMAStrip'].seedPart(deviationFactor=0.1, 
    minSizeFactor=0.1, size=0.008)
mdb.models['Model-1'].parts['SMAStrip'].generateMesh()
mdb.models['Model-1'].parts['SMAStrip'].setElementType(elemTypes=(ElemType(
    elemCode=S4RT, elemLibrary=STANDARD, secondOrderAccuracy=OFF, 
    hourglassControl=DEFAULT), ElemType(elemCode=S3T, elemLibrary=STANDARD)), 
    regions=(mdb.models['Model-1'].parts['SMAStrip'].faces.findAt(((0.333333, 
    0.033333, 0.0), )), ))
mdb.models['Model-1'].rootAssembly.regenerate()
